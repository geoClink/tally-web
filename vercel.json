{
  "crons": [
    {
      "path": "/api/send-weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/send-reengagement-email",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/send-billing-reminder",
      "schedule": "0 9 * * *"
    }
  ],
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/support", "destination": "/support.html" },
    { "source": "/android-beta", "destination": "/android-beta.html" },
    { "source": "/confirm", "destination": "/confirm.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/track-billable-hours", "destination": "/guides/track-billable-hours.html" },
    { "source": "/guides/invoice-clients-hourly-work", "destination": "/guides/invoice-clients-hourly-work.html" },
    { "source": "/guides/freelance-time-tracking", "destination": "/guides/freelance-time-tracking.html" },
    { "source": "/guides/set-freelance-hourly-rate", "destination": "/guides/set-freelance-hourly-rate.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
